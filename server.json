    "source": "github"
  },
  "version": "2.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "ng-checkup-cli",
      "version": "2.4.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
