{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.stefankuburovic/ng-checkup",
  "title": "ng-checkup",
  "description": "Angular and AngularJS modernization checkup: findings, grades and the upgrade plan of a workspace.",
  "repository": {
