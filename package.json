{
  "name": "ng-checkup",
  "version": "0.10.0",
  "description": "A one-minute modernization report for any Angular codebase: version gap, deprecated APIs, zoneless readiness, signals adoption, test runner, type safety and circular dependencies.",
  "keywords": [
    "angular",
    "audit",
    "migration",
    "modernization",
    "zoneless",
    "signals",
    "health-check",
    "cli"
  ],
  "license": "MIT",
  "author": "Stefan Kuburovic",
  "homepage": "https://github.com/stefankuburovic/ng-checkup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefankuburovic/ng-checkup.git"
  },
  "bugs": {
    "url": "https://github.com/stefankuburovic/ng-checkup/issues"
  },
  "type": "module",
  "bin": {
    "ng-checkup": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schematics/*": "./schematics/*"
  },
  "files": [
    "dist",
    "schematics"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test",
    "checkup": "node dist/cli.js",
    "corpus": "node scripts/corpus.mjs"
  },
  "dependencies": {
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
