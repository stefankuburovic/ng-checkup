{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "NgCheckupNgAdd",
  "title": "ng-checkup ng-add",
  "type": "object",
  "properties": {
    "ci": {
      "type": "string",
      "enum": ["auto", "github", "gitlab", "none"],
      "default": "auto",
      "description": "Where to add the CI step. auto uses GitHub when .github/ exists, GitLab when .gitlab-ci.yml does.",
      "x-prompt": {
        "message": "Add a CI step that runs the checkup on every pull request?",
        "type": "list",
        "items": [
          { "value": "auto", "label": "Yes, for the CI this repository already uses" },
          { "value": "github", "label": "Yes, GitHub Actions" },
          { "value": "gitlab", "label": "Yes, GitLab CI" },
          { "value": "none", "label": "No" }
        ]
      }
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Replace an existing \"checkup\" script."
    }
  }
}
